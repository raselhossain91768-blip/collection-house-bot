# Port for the Webhook & Dashboard Server
PORT=3000

# Meta Facebook Developer Configuration
# 1. Verify Token: Set any secret string here and enter the same string in Meta Webhook settings
VERIFY_TOKEN=collection_house_webhook_token_2026

# 2. Page Access Token: Generated from Meta Developer Portal under Messenger > API Settings
PAGE_ACCESS_TOKEN=

# 3. App Secret (Optional): Found in Meta App Dashboard > App Settings > Basic
APP_SECRET=

# AI Model Configuration (Optional - Smart Built-in Bengali NLP is active by default)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
